#!/bin/bash
set -e

ROOT=$(git rev-parse --show-toplevel)
BACKEND="$ROOT/backend"
MOBILE="$ROOT/mobile"

fail() {
    echo ""
    echo "[PUSH 차단] $1"
    exit 1
}

# ── Backend ──────────────────────────────────────────────

echo ""
echo "=== [Backend] 린트 ==="
cd "$BACKEND"
./gradlew ktlintCheck --quiet || fail "Backend 린트 실패"
echo "Backend 린트 통과"

echo ""
echo "=== [Backend] 빌드 ==="
./gradlew assemble -x test --quiet || fail "Backend 빌드 실패"
echo "Backend 빌드 통과"

echo ""
echo "=== [Backend] 테스트 ==="
./gradlew test --quiet || fail "Backend 테스트 실패"
echo "Backend 테스트 통과"

# ── Flutter ──────────────────────────────────────────────

echo ""
echo "=== [Flutter] 린트 ==="
cd "$MOBILE"
flutter analyze --no-fatal-infos || fail "Flutter 린트 실패"
echo "Flutter 린트 통과"

echo ""
echo "=== [Flutter] 빌드 ==="
flutter build apk --debug 2>&1 | tail -5 || fail "Flutter 빌드 실패"
echo "Flutter 빌드 통과"

echo ""
echo "=== [Flutter] 테스트 ==="
flutter test || fail "Flutter 테스트 실패"
echo "Flutter 테스트 통과"

echo ""
echo "모든 검사 통과 — 푸시를 진행합니다."
