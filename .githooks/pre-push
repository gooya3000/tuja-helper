#!/bin/bash
set -e

ROOT=$(git rev-parse --show-toplevel)
BACKEND="$ROOT/backend"
MOBILE="$ROOT/mobile"
FLAG=/tmp/tuja_tests_passed

export PATH="$PATH:$HOME/Desktop/dev/flutter/bin:$HOME/flutter/bin:/opt/homebrew/bin"

fail() {
    echo ""
    echo "[PUSH 차단] $1"
    exit 1
}

# ── 문서 전용 변경 시 스킵 ───────────────────────────────

PUSH_INPUT=$(cat)
NON_DOC=""
while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_ref" ] && continue
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        RANGE="$local_sha"
    else
        RANGE="${remote_sha}..${local_sha}"
    fi
    NON_DOC="$NON_DOC$(git diff --name-only "$RANGE" 2>/dev/null | grep -vE '\.(md|txt)$|^docs/' || true)"
done <<< "$PUSH_INPUT"

if [ -z "$(echo "$NON_DOC" | tr -d '[:space:]')" ]; then
    echo "문서 변경만 감지 — 검사를 건너뜁니다."
    exit 0
fi

# ── Backend ──────────────────────────────────────────────

echo ""
echo "=== [Backend] 린트 ==="
cd "$BACKEND"
./gradlew ktlintCheck --quiet || fail "Backend 린트 실패"
echo "Backend 린트 통과"

echo ""
echo "=== [Backend] 빌드 ==="
./gradlew assemble -x test --quiet || fail "Backend 빌드 실패"
echo "Backend 빌드 통과"

# ── Flutter ──────────────────────────────────────────────

echo ""
echo "=== [Flutter] 린트 ==="
cd "$MOBILE"
flutter analyze --no-fatal-infos || fail "Flutter 린트 실패"
echo "Flutter 린트 통과"

# ── 테스트 (integration 에이전트가 통과 확인 시 스킵) ────

if [ -f "$FLAG" ]; then
    echo ""
    echo "=== 테스트 스킵 (integration 에이전트 통과 확인됨) ==="
    rm "$FLAG"
else
    echo ""
    echo "=== [Backend] 테스트 ==="
    cd "$BACKEND"
    ./gradlew test --quiet || fail "Backend 테스트 실패"
    echo "Backend 테스트 통과"

    echo ""
    echo "=== [Flutter] 테스트 ==="
    cd "$MOBILE"
    flutter test || fail "Flutter 테스트 실패"
    echo "Flutter 테스트 통과"
fi

echo ""
echo "모든 검사 통과 — 푸시를 진행합니다."
